# =============================================================================
#  .env.example  —  copy to .env for LOCAL runs, or add each as a GitHub Actions
#  secret for production. NEVER commit a real .env. config.yaml holds NO secrets;
#  every secret lives here.
#
#  Local use:   cp .env.example .env   then fill in real values.
#  GitHub use:  Repo > Settings > Secrets and variables > Actions > New secret,
#               one per variable below (same names).
# =============================================================================

# --- Supabase (Database) -----------------------------------------------------
# From Supabase dashboard > Project Settings > API.
# URL looks like https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Use the SERVICE ROLE key (Project Settings > API > service_role). It is secret —
# it bypasses row-level security. The bot is a trusted backend, so this is correct.
SUPABASE_KEY=

# --- Telegram ----------------------------------------------------------------
# Create a bot with @BotFather, copy the token it gives you (looks like
# 123456789:AAA...). The bot must be an ADMIN of every channel it posts to.
TELEGRAM_BOT_TOKEN=

# Channel IDs (NOT secret, but kept here so they stay out of the public repo).
# For a private channel the ID looks like -1001234567890. See README for how to
# find it. config.yaml references these via ${...}.
TELEGRAM_SEC_PAID_CHANNEL=
TELEGRAM_SEC_FREE_CHANNEL=
TELEGRAM_FDA_PAID_CHANNEL=
TELEGRAM_FDA_FREE_CHANNEL=

# --- SEC EDGAR User-Agent ----------------------------------------------------
# SEC REQUIRES a descriptive User-Agent in the form "AppName email@domain".
# Use a real, monitored email — SEC may contact you about traffic.
SEC_APP_NAME=SecBiotechBot
SEC_CONTACT_EMAIL=

# --- Google Gemini (OPTIONAL) ------------------------------------------------
# Only needed when config.yaml summarizer.backend = "gemini". Get a free key at
# https://aistudio.google.com/app/apikey . Leave blank to use the template
# backend (default). If a Gemini call fails, the system silently falls back to
# the template — an alert is never dropped because the AI failed.
GEMINI_API_KEY=
